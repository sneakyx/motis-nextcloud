{
    "name": "sneakyx/motis-nextcloud",
    "description": "Nextcloud app that brings MOTIS-powered public transit routing to calendar events, contacts and free route search",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "André Scholz",
            "homepage": "https://github.com/sneakyx"
        }
    ],
    "require": {
        "php": "^8.2",
        "sneakyx/motis-php-client": "^0.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.16",
        "nextcloud/coding-standard": "^1.3",
        "nextcloud/ocp": "^33.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\Motis\\": "lib/",
            "OCA\\Motis\\Test\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/",
            "OC\\": "vendor/nextcloud/ocp/OC/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "lint": "find lib tests -name '*.php' -not -path '*/vendor/*' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff --allow-unsupported-php-version=yes",
        "cs:fix": "php-cs-fixer fix --allow-unsupported-php-version=yes",
        "test:unit": "phpunit -c tests/phpunit.unit.xml"
    }
}

  ],
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.0-rc.9",
    "@nextcloud/stylelint-config": "^3.2.1",
    "@nextcloud/typings": "^1.10.0",
    "@nextcloud/vite-config": "^2.5.2",
    "@vue/tsconfig": "^0.9.0",
    "typescript": "^6.0.2",
